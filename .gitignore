# secrets — jamais dans le dépôt
.env
.env.local
.env.*.local
*.pem
*.key

# couverture et artefacts de test
.couverture/
cov/
*.lcov

# dépendances
node_modules/
vendor/

# système
.DS_Store
Thumbs.db

# Supabase local
supabase/.temp/
supabase/.branches/

# Les archives de livraison : elles atterrissent ici, elles ne sont pas le dépôt.
livraison.zip

# La feuille que le travail « contraste » du CI cree et efface aussitot.
# Elle ne doit jamais entrer dans le depot : elle rend le titre des
# cartes illisible expres.
css/99-essai-contraste.css
apercu-sujet.html
templates/*.a-publier.html

# Les photos que les harnais rendent avec `--photo` : on les regarde,
# on ne les garde pas. Ancrées à la racine, pour ne pas toucher `img/`.
/staff-*.png
/statistiques-*.png
/profil-*.png
/repertoire-*.png
/apercu-repertoire-*.png
/apercu-fiche-*.png
/recherche-*.png
/messagerie-*.png
/barre.png
/qui-est-en-ligne-*.png
/en-ligne-*.png

# Le calque de contrôle du découpage, rendu par `carte-decoupage.py --rendu` :
# on le regarde avant de valider, il ne fait pas partie du dépôt.
planches/decoupage.png

# python
__pycache__/
*.pyc

#  LES TROIS FORMES DE COMPARAISON NE SE LIVRENT PAS. Seule la forme
#  retenue est versionnée ; `python3 outils/arbre.py --formes` écrit les
#  trois pour les regarder côte à côte, et ça ne regarde que la machine
#  qui les a écrites.
/pages/arbre-des-paliers-*.html
