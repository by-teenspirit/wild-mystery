# secrets — jamais dans le dépôt
.env
.env.local
.env.*.local
*.pem
*.key

# couverture et artefacts de test
.couverture/
cov/
*.lcov

# dépendances
node_modules/
vendor/

# système
.DS_Store
Thumbs.db

# Supabase local
supabase/.temp/
supabase/.branches/

# Les archives de livraison : elles atterrissent ici, elles ne sont pas le dépôt.
livraison.zip

# La feuille que le travail « contraste » du CI cree et efface aussitot.
# Elle ne doit jamais entrer dans le depot : elle rend le titre des
# cartes illisible expres.
css/99-essai-contraste.css
apercu-sujet.html
templates/*.a-publier.html

# Les photos que les harnais rendent avec `--photo` : on les regarde,
# on ne les garde pas. Ancrées à la racine, pour ne pas toucher `img/`.
/staff-*.png
/statistiques-*.png
/profil-*.png
/repertoire-*.png
/apercu-repertoire-*.png
/recherche-*.png
/messagerie-*.png
/barre.png

# python
__pycache__/
*.pyc
