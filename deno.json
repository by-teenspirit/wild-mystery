{
  "name": "@by-teenspirit/wild-mystery",
  "version": "0.1.0",
  "exports": {},
  "imports": {
    "@std/assert": "./vendoreur/std-assert/mod.ts",
    "@std/assert/": "./vendoreur/std-assert/",
    "@std/internal/": "./vendoreur/std-internal/"
  },
  "tasks": {
    "verif": "deno fmt --check && deno lint && deno check src/ js/ supabase/functions/releve/index.ts && bash outils/garde-fou.sh",
    "test": "deno test src/domaine/",
    "test:usage": "deno test --allow-env src/application/",
    "test:contrat": "deno test --allow-env --allow-net --allow-read --allow-run src/contrat/",
    "couverture": "bash outils/couverture.sh",
    "garde-fou": "bash outils/garde-fou.sh",
    "test:adaptateurs": "deno test --allow-read src/adaptateurs/",
    "test:tout": "deno test --allow-env --allow-read --allow-net --allow-run src/",
    "css": "bash outils/css.sh",
    "construire": "deno bundle --platform browser --format iife --minify -o js/wild-mystery.js js/wild-mystery.ts && deno bundle --platform browser --format iife --minify -o js/annexes.js js/annexes.ts && deno bundle --platform browser --format iife --minify -o js/carnet.js js/carnet.ts && deno bundle --platform browser --format iife --minify -o js/carte.js js/carte.ts",
    "test:navigateur": "deno test --allow-env --allow-read=data/accueil.json,img/accueil src/navigateur/",
    "harnais": "deno bundle --platform browser --format iife -o js/harnais-sommaire.js js/harnais-sommaire.ts",
    "contraste": "deno run -A outils/contraste.mjs",
    "annexes": "python3 outils/annexe-carte.py && python3 outils/annexe-personnages.py && python3 outils/annexe-credits.py && python3 outils/annexes.py",
    "annexe-carte": "python3 outils/annexe-carte.py",
    "annexe-personnages": "python3 outils/annexe-personnages.py",
    "annexe-credits": "python3 outils/annexe-credits.py",
    "navigation": "deno run -A outils/navigation.mjs",
    "confort": "deno run -A outils/confort.mjs",
    "accueil": "deno run -A outils/accueil.mjs",
    "carte": "deno run -A outils/carte.mjs",
    "enligne": "deno run -A outils/enligne.mjs",
    "categories": "deno run -A outils/categories.mjs",
    "messenger": "deno run -A outils/messenger.mjs",
    "barre": "deno run -A outils/barre.mjs",
    "boutique": "deno run -A outils/boutique.mjs",
    "zone": "deno run -A outils/zone.mjs",
    "sujet": "deno run -A outils/sujet.mjs",
    "poster": "deno run -A outils/poster.mjs",
    "etat": "bash outils/etat.sh",
    "apercu": "deno run -A outils/sujet.mjs --apercu",
    "a-publier": "deno run -A outils/a-publier.mjs",
    "membres": "deno run -A outils/membres.mjs",
    "tcard": "deno run -A outils/tcard.mjs",
    "carnet": "deno run -A outils/carnet.mjs",
    "faune": "deno run -A outils/faune.mjs",
    "natures": "deno run --allow-read=. outils/natures.ts"
  },
  "fmt": {
    "include": [
      "src/",
      "supabase/functions/",
      "deno.json",
      "js/"
    ],
    "lineWidth": 96,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "exclude": [
      "src/adaptateurs/forumactif/fixtures/",
      "vendoreur/",
      "js/wild-mystery.js",
      "js/annexes.js",
      "js/harnais-sommaire.js",
      "js/carnet.js",
      "js/carte.js"
    ]
  },
  "lint": {
    "include": [
      "src/",
      "supabase/functions/",
      "js/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "no-explicit-any",
        "explicit-function-return-type",
        "eqeqeq",
        "no-throw-literal"
      ]
    },
    "exclude": [
      "vendoreur/",
      "js/wild-mystery.js",
      "js/annexes.js",
      "js/harnais-sommaire.js",
      "js/carnet.js",
      "js/carte.js"
    ]
  },
  "test": {
    "include": [
      "src/"
    ],
    "exclude": [
      "vendoreur/"
    ]
  }
}
